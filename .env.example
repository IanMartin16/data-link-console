# --- Backend engines -------------------------------------------------
# core (deduplicacion). Servicio Railway #1
# Antes se llamaba NEXT_PUBLIC_DATALINK_API_URL — renombrada porque ahora hay dos motores
NEXT_PUBLIC_CORE_API_URL=https://core.up.railway.app
# transform (mask / ETL / parquet). Servicio Railway #2 — aun sin usar
NEXT_PUBLIC_TRANSFORM_API_URL=

# --- Auth ------------------------------------------------------------
# core todavia no expone rutas de login. La credencial es la API key
# (localStorage). Cuando core tenga /auth, restaurar _future/auth.nextauth.ts.txt

# --- Stripe (publica; las secretas viven en el backend de core) ------
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Marca -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://data-link.dev
